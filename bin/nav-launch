#!/bin/sh
# herdr-nav: start the binary for herdr's popup pane.
#
# Prefers the plugin's own build (target/release/, put there by
# bin/fetch-binary during `herdr plugin install`, or by `just build` /
# `just link` in a dev checkout), then a herdr-nav on PATH (e.g.
# installed with mise for Rex). If neither exists, explain instead of
# letting the popup flash shut.
#
# This wrapper is herdr's entry point only, so it pins the host: a
# herdr running inside a Rex terminal (or the reverse) must not be
# detected as the other multiplexer.
NAV_HOST=herdr
export NAV_HOST
here=$(cd "$(dirname "$0")/.." && pwd)
if [ -x "$here/target/release/herdr-nav" ]; then
  exec "$here/target/release/herdr-nav" "$@"
fi
if command -v herdr-nav >/dev/null 2>&1; then
  exec herdr-nav "$@"
fi
printf '\n  herdr-nav: no binary found.\n\n'
printf '  Reinstall the plugin (herdr plugin install codingfragments/herdr-nav),\n'
printf '  or install the binary: mise use -g github:codingfragments/herdr-nav\n\n'
printf '  Press Enter to close. '
read -r _
exit 1
